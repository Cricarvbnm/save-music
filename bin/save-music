#!/usr/bin/env bash

# Default values
default_original_dir=original
default_normalized_dir=normalized
default_format=mp3

# Help
help_str="save-music -t|--title title -a|--artist artist [-o|--original-dir original_dir[='$default_original_dir']] [-n|--normalized-dir normalized_dir[='$default_normalized_dir']] [-i|--input-format input_format=mp3] [-O|--output-format output_format=<mp3|flac>] <music_url> [lrc_url]"

# Initializaiton
title=
artist=
original_dir=""
normalized_dir=""
input_format="$default_format"
output_format="$default_format"
music_url=
lrc_url=

# Parse arguments
if ! parsed_args=$(getopt \
        -o "t:a:o::n::i:O:" \
        --long "help,title:,artist:,original-dir::,normalized-dir::,input-format:,output-format:" \
    -- "$@"); then
    echo "参数解析错误" >&2
    echo "使用方法: $help_str" >&2
    exit 1
fi

eval set -- "$parsed_args"
unset parsed_args

while true; do
  case "$1" in
    --help)
      echo "$help_str"
      exit 0
      ;;
    -t|--title)
      title="$2"
      ;;
    -a|--artist)
      artist="$2"
      ;;
    -o|--original-dir)
      case "$2" in
        '')
          original_dir="$default_original_dir"
          ;;
        *)
          original_dir="$2"
          ;;
      esac
      ;;
    -n|--normalized-dir)
      case "$2" in
        '')
          normalized_dir="$default_normalized_dir"
          ;;
        *)
          normalized_dir="$2"
          ;;
      esac
      ;;
    -i|--input-format)
      input_format="$2"
      ;;
    -O|--output-format)
      output_format="$2"
      if ! [[ "$output_format" =~ ^(mp3|flac) ]]; then
        echo "error: unsupported output format '$output_format'" >&2
      fi
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "error: unknown option: '$1'" >&2
      exit 1
      ;;
  esac
  shift 2
done

music_url="${1:-}"
lrc_url="${2:-}"

# Validate arguments
if [ -z "$title" ] || [ -z "$artist" ]; then
  echo "error: missing arguments for '--title' or '--artist'" >&2
  echo "$help_str" >&2
  exit 1
fi

if [ -z "$music_url" ]; then
  echo "error: missing 'music_url'" >&2
  echo "$help_str" >%2
  exit 1
fi

# Debug info
echo "title = $title" >&2
echo "artist = $artist" >&2
echo "original_dir = $original_dir" >&2
echo "normalized_dir = $normalized_dir" >&2
echo "input_format = $input_format" >&2
echo "output_format = $output_format" >&2
echo "music_url = $music_url" >&2
echo "lrc_url = $lrc_url" >&2

# Cache
cache_dir="$HOME/.cache/save-music"
mkdir -p "$cache_dir"

# Filenames
name="$title - $artist"
original_cache_path="$cache_dir/$name.$input_format"
converted_cache_path="$cache_dir/$name.$output_format"

if [ -n "$lrc_url" ]; then
  lrc_cache_path="$cache_dir/$name.lrc"
fi

# Download
if ! curl -H 'User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:141.0) Gecko/20100101 Firefox/141.0' \
    --create-dirs --fail --progress-bar "$music_url" --output "$original_cache_path"; then
    echo "error: music downloading" >&2
    exit 1
fi

if [ -n "$lrc_url" ]; then
  if ! curl -H 'User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:141.0) Gecko/20100101 Firefox/141.0' \
      --create-dirs --fail --progress-bar "$lrc_url" --output "$lrc_cache_path"; then
    echo "error: lrc downloading" >&2
    exit 1
  fi
fi

# Convertion (flac -> mp3)
if [[ "$input_format" != "$output_format" ]]; then
  if ! ffmpeg -hide_banner -i "$original_cache_path" -q 0 -c:v copy "$converted_cache_path"; then
    echo "error: convertion (flac -> mp3)" >&2
    exit 1
  fi
fi

# Normalization
normalized_path=
if [ -n "$normalized_dir" ]; then
  mkdir -p "$normalized_dir"
  normalized_path="$normalized_dir/$name.$output_format"

  case "$output_format" in
    mp3)
      echo "mp3 normalizing..." >&2
      if ! mp3-normalize "$converted_cache_path" --output-folder "$normalized_dir"; then
        echo "error: mp3 normalize" >&2
        exit 1
      fi
      ;;
    flac)
      echo "flac normalizing..." >&2
      if ! flac-normalize "$converted_cache_path" --output-folder "$normalized_dir"; then
        echo "error: flac normalize" >&2
        exit 1
      fi
      ;;
  esac
fi

# Tag
if [ -n "$normalized_path" ] && [ -f "$normalized_path" ]; then
  kid3-cli -c "set title '$title'" \
    -c "set artist '$artist'" \
    "$normalized_path"
fi

# Settlement
if [ -n "$original_dir" ]; then
  mkdir -p "$original_dir"

  if [ -f "$original_cache_path" ]; then
    cp "$original_cache_path" "$original_dir"
  fi

  if [ -n "$lrc_cache_path" ] && [ -f "$lrc_cache_path" ]; then
    cp "$lrc_cache_path" "$original_dir"
  fi
fi

if [ -n "$normalized_dir" ] && [ -n "$lrc_cache_path" ] && [ -f "$lrc_cache_path" ]; then
  cp "$lrc_cache_path" "$normalized_dir"
fi

