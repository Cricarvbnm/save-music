pkgname=save-music
pkgver=3.0.0
pkgrel=1

arch=(any)

depends=(curl ffmpeg ffmpeg-normalize kid3-common bash)
makedepends=(argbash make)

build() {
  cd "$srcdir/save-music-$pkgver" || exit 1
  make
}

package() {
  cd "$srcdir/save-music-$pkgver" || exit 1
  make install DESTDIR="$pkgdir" PREFIX=/usr
}

source=(https://github.com/Cricarvbnm/save-music/archive/refs/tags/v3.0.0.zip)
sha256sums=('794b7b2c0ff09fbd6ea8cc792fd3bf26afca0293c4e923a4f2e308b5b5df765b')
