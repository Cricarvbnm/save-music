pkgname=save-music
pkgver=2.0.0
pkgrel=1

arch=(any)

depends=(curl ffmpeg kid3-common bash)
makedepends=(argbash make)

package() {
  install -d "$pkgdir/usr"
  cp -r "$srcdir"/$pkgname-$pkgver/src/{bin,share} "$pkgdir/usr"
  argbash "$srcdir/$pkgname-$pkgver/src/templates/argbash/save-music.tmpl" -o "$pkgdir/usr/bin/save-music"
}

source=(https://github.com/Cricarvbnm/save-music/archive/refs/tags/v2.0.0.zip)
sha256sums=('0f64ad3b8362ec33a800311428f1a8e945a58f15ccc07f1efd071e02e983d8bf')
