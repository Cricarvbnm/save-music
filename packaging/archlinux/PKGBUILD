pkgname=save-music
pkgver=3.1.0
pkgrel=1

arch=(any)

depends=(curl ffmpeg ffmpeg-normalize kid3-common bash)
makedepends=(argbash make)

build() {
  cd "$srcdir/save-music-$pkgver" || exit 1
  make
}

package() {
  cd "$srcdir/save-music-$pkgver" || exit 1
  make install DESTDIR="$pkgdir" PREFIX=/usr
}

source=(https://github.com/Cricarvbnm/save-music/archive/refs/tags/v"$pkgver".zip)
sha256sums=('691279fa8e5ceb348c746d720f8e958b00dc3010da1b77ccba33d20cca6fe16c')
