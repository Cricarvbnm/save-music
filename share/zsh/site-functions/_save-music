#compdef save-music

_save-music() {
  _arguments \
    {-t,--title}'[title]' \
    {-a,--artist}"[artist]" \
    {-o-,--original-dir=-}'[original directory]:_files -/' \
    {-n-,--normalized-dir=-}'[normalized directory]:_files -/' \
    {-i,--input-format}'[extension name of the input file]' \
    {-O,--output-format}'[extension name of the output file]:(mp3 flac)' \
    ':urls' \
    ':urls'
}
